# P80 local configuration.
#
# Copy to .env.local. This file holds LOCAL ENDPOINT CONFIG ONLY.
#
# There are no API keys in P80 (ADR 0005 — all inference is local, spec §32.3,
# CLAUDE.md rule 14). Nothing here is a secret. If you find yourself wanting to add
# a credential, the task is wrong — stop and ask.

# --- Process binding (spec §32.5, CLAUDE.md rule 13) ---
# Loopback only. Changing this is opt-in LAN exposure and logs a warning at startup.
P80_BIND_HOST=127.0.0.1
P80_ALLOW_LAN=false

P80_API_PORT=5180
P80_WEB_PORT=5173
P80_NLP_PORT=5181

# --- Reverse-proxy origins (ADR 0023) ---
# Extra browser origins the API accepts, comma-separated. EMPTY BY DEFAULT.
#
# Only needed when something proxies P80 under a name that is not loopback — a Tailscale
# `serve` mapping being the case this was written for. P80 still binds 127.0.0.1; the proxy
# listens. Without the origin listed here the page loads and every WRITE fails with
# ORIGIN_NOT_ALLOWED, because browsers send `Origin` on anything that is not GET or HEAD.
#
# Setting it warns at startup, like P80_ALLOW_LAN. P80 has no authentication of any kind,
# so whatever can reach this origin can read and change everything: the proxy's own access
# control is the only gate. Entries are bare origins — scheme://host[:port], no path, no
# wildcard. A wildcard is refused rather than interpreted.
#
#   P80_TRUSTED_ORIGINS=https://p80.your-tailnet.ts.net
P80_TRUSTED_ORIGINS=

# --- Storage ---
# Both are resolved against the repository root, not the working directory, because the
# API and worker are started by `pnpm --filter` and each runs somewhere different.
P80_DB_PATH=./data/p80.db
# Uploaded transcript files (spec §7.2). Kept after a transcript is deleted or replaced,
# so a replacement is recoverable. NEVER holds media (ADR 0015, CLAUDE.md rule 3).
P80_STORAGE_PATH=./data/storage

# --- Media library (ADR 0015) ---
# The only directory P80 will read media from. A path outside it is rejected, not
# normalised, so this value decides what is reachable at all.
#
# REQUIRED, with no default. Every other path here can be wrong quietly and recover; a
# default of ./data/media would silently make an empty directory the library, and the
# symptom — "my file isn't there" — points at the file rather than at the root.
#
# P80 reads these files where they are. It never copies them, never modifies them, and
# never acquires them: how a file got here is outside the system.
# Editable at runtime (ADR 0019) — this is the value P80 starts from, and the Settings
# surface can override it without an edit here. It is still required: a process that
# cannot start does not serve a settings page.
P80_MEDIA_ROOT=./data/media

# --- Logging ---
P80_LOG_LEVEL=info

# --- Local inference (ADR 0005) ---
# vLLM, OpenAI-compatible, loopback. Expect this to be DOWN during Stages 1-6 —
# that is the spec §5.2 degraded path getting free exercise, not a misconfiguration.
P80_VLLM_BASE_URL=http://127.0.0.1:8000/v1
P80_VLLM_MODEL_ID=

# --- NLP sidecar (ADR 0002, ADR 0016) ---
P80_NLP_BASE_URL=http://127.0.0.1:5181

# --- Local speech recognition (ADR 0016) ---
# Since ADR 0019 these are read here AND sent to the sidecar with each transcription
# request, so they are the seed rather than the last word: change them in P80's Settings
# page or with `p80 settings set`, and the stored value wins over this file until you
# clear it. Both surfaces show which is in effect.
#
# P80_ASR_REQUIRE_GPU=true makes a missing GPU a loud refusal instead of a job that runs
# twenty times slower and looks healthy for forty minutes. Set it to 0 to run on CPU
# deliberately.
P80_ASR_MODEL=large-v3
P80_ASR_DEVICE=cuda
P80_ASR_COMPUTE_TYPE=float16
P80_ASR_REQUIRE_GPU=true
# Forced alignment refines word timings. When unavailable, transcription still works and
# records `alignment_model_id: null` plus a warning — visibly less precise, never silently.
P80_ASR_ALIGN=true

# ---------------------------------------------------------------------------------------
# Container runtime (ADR 0025)
#
# Read by docker-compose.yml, not by P80. They are not configuration keys and do not appear
# on the settings surface — P80's own set is closed and asserted by a test.
#
# The containers run as this uid:gid so they can read your media library and write the
# database. The default below is right on a single-user Linux machine; set them if `id -u`
# says otherwise, or the containers will start and then be unable to read anything.
# ---------------------------------------------------------------------------------------
P80_UID=1000
P80_GID=1000
