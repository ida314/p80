# Generated by scripts/service-install.sh from deploy/systemd/p80-api.service.in.
# Edit the template, not this copy — a reinstall overwrites it.
[Unit]
Description=P80 API and browser client
Documentation=file://@REPO@/docs/SETUP.md
PartOf=p80.target
Requires=p80-migrate.service
After=network.target p80-migrate.service
# Five failures in five minutes and systemd stops trying. Restarting forever on a config
# error still shows as "activating", which is the least useful thing status could say.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@REPO@
# No `-` prefix, deliberately: a missing config file must stop the unit here. P80_MEDIA_ROOT
# has no default, so the alternative is failing one layer deeper with an error that reads
# as a broken API rather than as an unloaded config file.
EnvironmentFile=@REPO@/.env.local
Environment=PATH=@PATH@
# node directly, not `pnpm --filter @p80/api start`. Through pnpm the chain is
# pnpm -> sh -c -> tsx -> node: systemd's MainPID is pnpm, SIGTERM never reaches the
# shutdown handler in main.ts, and the service is SIGKILLed at the stop timeout instead of
# draining. One process means one signal path.
ExecStart=@NODE@ --import tsx apps/api/src/main.ts
Restart=always
RestartSec=5
KillSignal=SIGTERM
# The API drains in-flight requests; the worker finishes the job it has claimed. Both are
# well under this, and a genuinely hung process still gets SIGKILL rather than blocking a
# reboot.
TimeoutStopSec=60
NoNewPrivileges=yes

[Install]
WantedBy=p80.target
