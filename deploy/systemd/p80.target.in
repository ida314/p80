# Generated by scripts/service-install.sh from deploy/systemd/p80.target.in.
# Edit the template, not this copy — a reinstall overwrites it.
#
# The target deliberately lists no services. Each unit declares `WantedBy=p80.target`, so
# enabling it is what puts it in the group. That is what lets the sidecar be skipped on a
# machine where it runs somewhere else, without a `Wants=` line naming a unit that is not
# installed.
[Unit]
Description=P80 (api, worker, nlp sidecar)
Documentation=file://@REPO@/docs/SETUP.md

[Install]
WantedBy=default.target
