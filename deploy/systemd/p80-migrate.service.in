# Generated by scripts/service-install.sh from deploy/systemd/p80-migrate.service.in.
# Edit the template, not this copy — a reinstall overwrites it.
#
# Migrations already run inside the API and the worker, and both are written to tolerate
# losing the race. This unit exists for two other reasons:
#
#   - It removes the race rather than tolerating it. Two processes reaching for the same
#     SQLite write lock on first boot is contention nobody needs to reason about.
#   - It makes failure legible. A checksum mismatch on an applied migration is a hard
#     error; as one failed oneshot unit that is a sentence in `systemctl status`, where
#     inside the API it is a crash loop that reads as "the API is broken".
[Unit]
Description=P80 database migrations
Documentation=file://@REPO@/docs/SETUP.md
PartOf=p80.target
After=network.target

[Service]
Type=oneshot
# The API and worker order themselves after this unit, which only means anything if it
# stays active once it has exited.
RemainAfterExit=yes
WorkingDirectory=@REPO@
EnvironmentFile=@REPO@/.env.local
Environment=PATH=@PATH@
ExecStart=@NODE@ --import tsx packages/database/src/cli/migrate.ts
NoNewPrivileges=yes

[Install]
WantedBy=p80.target
