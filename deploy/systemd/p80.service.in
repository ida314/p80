# Generated by scripts/service-install.sh from deploy/systemd/p80.service.in.
# Edit the template, not this copy — a reinstall overwrites it.
#
# One unit for the whole application (ADR 0025). What used to be four units — the migration
# one-shot, the API, the worker, and the NLP sidecar — is now four services inside
# docker-compose.yml, and their ordering is expressed there.
#
# The unit is still worth having. Restart policies start containers when the daemon starts;
# they do not start under this user's own account at boot, they give the operator no single
# name to stop, and they have no timer. That is what this keeps.
[Unit]
Description=P80
Documentation=file://@REPO@/docs/SETUP.md
# The container daemon is a system service and a user unit cannot meaningfully require one,
# so the ordering below is a hint and `Restart=` is what actually handles losing the race
# with it at boot.
After=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO@
# Compose reads two environment files for two different purposes: `env_file:` inside the
# compose file populates each container, and this one resolves the `${...}` substitutions
# in the compose file itself. Both point at the same place; only this one has to be said
# out loud, because compose's own default is `.env` and P80 does not use that name.
Environment=COMPOSE_ENV_FILES=@REPO@/.env.local
# `up` in the foreground, not `up -d`. Attached, compose forwards every container's output
# to the journal, so `journalctl --user -u p80` shows the whole application rather than
# four separate `docker logs` invocations — which is the property the four units had and
# the one most worth not losing.
ExecStart=@DOCKER@ compose -f @REPO@/docker-compose.yml up --remove-orphans
ExecStop=@DOCKER@ compose -f @REPO@/docker-compose.yml down
Restart=always
RestartSec=5
KillSignal=SIGTERM
# The sidecar alone asks for 120s, because transcription holds it for minutes at a time and
# is not interruptible midway. This has to exceed the longest grace period in the compose
# file, or systemd kills compose while it is still waiting for a container to drain.
TimeoutStopSec=180
NoNewPrivileges=yes

[Install]
WantedBy=default.target
