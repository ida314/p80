# Generated by scripts/service-install.sh from deploy/systemd/p80-backup.service.in.
# Edit the template, not this copy — a reinstall overwrites it.
#
# Deliberately independent of p80.service. A backup is worth taking whether or not the
# rest of P80 is running, and it is the state P80 stops running that most wants one —
# so this runs the backup in a container of its own rather than reaching into a running
# one, and works with the application down.
[Unit]
Description=P80 database backup
Documentation=file://@REPO@/docs/SETUP.md

[Service]
Type=oneshot
WorkingDirectory=@REPO@
Environment=COMPOSE_ENV_FILES=@REPO@/.env.local
# VACUUM INTO, not a file copy (ADR 0012): the database is in WAL mode and held open by
# the API, so copying the .db alone yields a file missing its most recent writes. The CLI
# also prunes routine snapshots past the retention window; tagged ones are never touched.
# `run --rm` on the profiled service: a one-shot container that exits, rather than an
# `exec` into the API's, which would tie taking a backup to the application being up.
ExecStart=@DOCKER@ compose -f @REPO@/docker-compose.yml run --rm backup
NoNewPrivileges=yes
