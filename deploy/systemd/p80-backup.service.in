# Generated by scripts/service-install.sh from deploy/systemd/p80-backup.service.in.
# Edit the template, not this copy — a reinstall overwrites it.
#
# Not PartOf=p80.target. A backup is worth taking whether or not the rest of P80 is
# running, and it is the state P80 stops running that most wants one.
[Unit]
Description=P80 database backup
Documentation=file://@REPO@/docs/SETUP.md

[Service]
Type=oneshot
WorkingDirectory=@REPO@
EnvironmentFile=@REPO@/.env.local
Environment=PATH=@PATH@
# VACUUM INTO, not a file copy (ADR 0012): the database is in WAL mode and held open by
# the API, so copying the .db alone yields a file missing its most recent writes. The CLI
# also prunes routine snapshots past the retention window; tagged ones are never touched.
ExecStart=@NODE@ --import tsx packages/database/src/cli/backup.ts
NoNewPrivileges=yes
