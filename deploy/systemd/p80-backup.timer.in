# Generated by scripts/service-install.sh from deploy/systemd/p80-backup.timer.in.
# Edit the template, not this copy — a reinstall overwrites it.
[Unit]
Description=Daily P80 database backup
Documentation=file://@REPO@/docs/SETUP.md

[Timer]
OnCalendar=*-*-* 04:00:00
# A workstation is not a server: it is asleep or off at 04:00 more often than not. Without
# this, the backup that matters most — the one after a week of heavy use — is the one that
# never runs.
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
