# Generated by scripts/service-install.sh from deploy/systemd/p80-worker.service.in.
# Edit the template, not this copy — a reinstall overwrites it.
[Unit]
Description=P80 job worker
Documentation=file://@REPO@/docs/SETUP.md
PartOf=p80.target
Requires=p80-migrate.service
After=network.target p80-migrate.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@REPO@
EnvironmentFile=@REPO@/.env.local
Environment=PATH=@PATH@
# See p80-api.service for why this is node rather than pnpm. It matters more here: the
# worker's SIGTERM handler is what lets it finish the job it has claimed instead of
# abandoning a half-written transcript.
ExecStart=@NODE@ --import tsx apps/worker/src/main.ts
Restart=always
RestartSec=5
KillSignal=SIGTERM
# Transcription is the long one (ADR 0016) and can run for minutes, but it checks for a
# stop between stages rather than at the end. A job that outlives this is reclaimed by the
# next worker through claimed_by/claimed_at.
TimeoutStopSec=60
NoNewPrivileges=yes

[Install]
WantedBy=p80.target
