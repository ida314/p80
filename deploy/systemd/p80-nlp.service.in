# Generated by scripts/service-install.sh from deploy/systemd/p80-nlp.service.in.
# Edit the template, not this copy — a reinstall overwrites it.
#
# Installed only when P80_NLP_BASE_URL names a loopback host. Pointed elsewhere, the
# sidecar runs on that machine and a local one would be a process nothing talks to.
[Unit]
Description=P80 NLP sidecar
Documentation=file://@REPO@/docs/SETUP.md
PartOf=p80.target
After=network.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@REPO@
# The sidecar reads the same P80_* variables as everything else — the bind host, its port,
# and the ASR defaults it falls back to when a caller sends none.
EnvironmentFile=@REPO@/.env.local
Environment=PATH=@PATH@
# Pinned explicitly rather than left to the default, because it decides where roughly
# 1.5 GB of speech model lives. An unset HOME in a service context would re-download it on
# every start, and that failure looks like slowness rather than like misconfiguration.
Environment=HF_HOME=%h/.cache/huggingface
# The venv's console script, not `uv run`. Same reasoning as node-over-pnpm in the other
# units: uvicorn's own SIGTERM handling is the graceful path, and it only gets the signal
# if it is the main process.
ExecStart=@NLP_BIN@
Restart=always
RestartSec=5
KillSignal=SIGTERM
# Transcription holds this process for minutes at a time and is not interruptible midway.
# Stopping during one is meant to wait rather than to truncate.
TimeoutStopSec=120
NoNewPrivileges=yes

[Install]
WantedBy=p80.target
